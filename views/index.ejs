<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Парковка — места</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      min-height: 100vh;
      color: #e8eef2;
      padding: 40px 20px;
    }
    .container { max-width: 1100px; margin: 0 auto; }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    h1 { font-size: 1.7rem; font-weight: 700; }
    h1 span { color: #4fc3f7; }
    .header-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    .user-label { color: #b0bec5; font-size: 0.9rem; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      background: #4fc3f7;
      color: #0f2027;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .btn-outline {
      background: transparent;
      color: #4fc3f7;
      border: 2px solid #4fc3f7;
    }
    .btn-danger { background: #ef5350; color: #fff; }
    .btn-sm { padding: 8px 12px; font-size: 0.85rem; }
    .stats {
      display: flex;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .stat {
      background: rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 12px 20px;
      min-width: 100px;
    }
    .stat-value { font-size: 1.5rem; font-weight: 700; color: #4fc3f7; }
    .stat-label { font-size: 0.8rem; color: #90a4ae; }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
      align-items: center;
    }
    .toolbar-label { color: #90a4ae; font-size: 0.85rem; margin-right: 4px; }
    .chip {
      padding: 8px 14px;
      border-radius: 20px;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      border: 1px solid rgba(79,195,247,0.4);
      color: #b0bec5;
      background: rgba(0,0,0,0.2);
    }
    .chip.active {
      background: #4fc3f7;
      color: #0f2027;
      border-color: #4fc3f7;
    }
    .error {
      background: rgba(244,67,54,0.2);
      border: 1px solid rgba(244,67,54,0.4);
      color: #ef9a9a;
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 16px;
    }
    .hint { color: #b0bec5; margin-bottom: 16px; font-size: 0.9rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }
    .card {
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .card-number { font-size: 1.4rem; font-weight: 700; color: #4fc3f7; }
    .card-meta { font-size: 0.92rem; color: #b0bec5; }
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      width: fit-content;
    }
    .badge-free { background: rgba(76,175,80,0.25); color: #81c784; }
    .badge-busy { background: rgba(244,67,54,0.25); color: #e57373; }
    .badge-mine { background: rgba(79,195,247,0.3); color: #4fc3f7; }
    .card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }
    .card-actions form { margin: 0; }
    .empty {
      text-align: center;
      padding: 50px 20px;
      color: #90a4ae;
    }
    .seat {
      width: 56px;
      height: 56px;
      border-radius: 10px;
      border: 2px solid rgba(255,255,255,0.2);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
      background: rgba(76,175,80,0.25);
      color: #c8e6c9;
    }
    .seat.busy {
      background: rgba(244,67,54,0.3);
      color: #ffcdd2;
      cursor: default;
    }
    .seat.mine {
      background: rgba(79,195,247,0.45);
      color: #e1f5fe;
      border-color: #4fc3f7;
      cursor: pointer;
    }
    .seatform { display: inline; margin: 0; }
    .zone-block { margin-bottom: 28px; }
    .zone-title { color: #4fc3f7; margin-bottom: 12px; font-size: 1.1rem; }
    .seats-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .legend { color: #90a4ae; font-size: 0.85rem; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🅿️ <span>Парковка</span> — места</h1>
      <div class="header-actions">
        <% if (currentUser) { %>
          <span class="user-label"><%= currentUser.email %> (<%= currentUser.role %>)</span>
          <% if (currentUser.role === 'admin') { %>
            <a href="/add" class="btn">+ Место</a>
            <a href="/admin/users" class="btn btn-outline">Пользователи</a>
          <% } %>
          <form action="/logout" method="POST">
            <button type="submit" class="btn btn-outline">Выйти</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn">Вход</a>
          <a href="/register" class="btn btn-outline">Регистрация</a>
        <% } %>
      </div>
    </header>

    <% const total = spaces.length; %>
    <% const freeCount = spaces.filter(function(s) { return s.occupiedByUserId == null; }).length; %>
    <div class="stats">
      <div class="stat">
        <div class="stat-value"><%= total %></div>
        <div class="stat-label">В списке</div>
      </div>
      <div class="stat">
        <div class="stat-value"><%= freeCount %></div>
        <div class="stat-label">Свободно</div>
      </div>
      <div class="stat">
        <div class="stat-value"><%= total - freeCount %></div>
        <div class="stat-label">Занято</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (currentUser && currentUser.role !== 'admin') { %>
      <p class="hint">Занято вами: <%= myOccupiedCount %> / <%= myMaxSpaces %></p>
    <% } %>

    <div class="toolbar">
      <span class="toolbar-label">Вид:</span>
      <a class="chip <%= view === 'list' ? 'active' : '' %>"
         href="/?view=list&filter=<%= filter %>&sort=<%= sort %>&group=<%= groupBy %>">Список</a>
      <a class="chip <%= view === 'map' ? 'active' : '' %>"
         href="/?view=map&filter=<%= filter %>&sort=<%= sort %>&group=<%= groupBy %>">Карта мест</a>
    </div>

    <div class="toolbar">
      <span class="toolbar-label">Фильтр:</span>
      <a class="chip <%= filter === 'all' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=all&sort=<%= sort %>&group=<%= groupBy %>">Все</a>
      <a class="chip <%= filter === 'free' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=free&sort=<%= sort %>&group=<%= groupBy %>">Свободные</a>
      <a class="chip <%= filter === 'busy' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=busy&sort=<%= sort %>&group=<%= groupBy %>">Занятые</a>
      <span class="toolbar-label" style="margin-left:8px;">Сортировка:</span>
      <a class="chip <%= sort === 'id' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=id&group=<%= groupBy %>">По id</a>
      <a class="chip <%= sort === 'number' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=number&group=<%= groupBy %>">По номеру</a>
      <a class="chip <%= sort === 'price' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=price&group=<%= groupBy %>">По цене</a>
      <a class="chip <%= sort === 'created' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=created&group=<%= groupBy %>">Сначала новые</a>
    </div>

    <div class="toolbar">
      <span class="toolbar-label">Группы:</span>
      <a class="chip <%= groupBy === 'zone' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=<%= sort %>&group=zone">По зоне</a>
      <a class="chip <%= groupBy === 'floor' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=<%= sort %>&group=floor">По этажу</a>
      <a class="chip <%= groupBy === 'floor-zone' ? 'active' : '' %>"
         href="/?view=<%= view %>&filter=<%= filter %>&sort=<%= sort %>&group=floor-zone">Этаж + зона</a>
    </div>

    <% if (spaces.length === 0) { %>
      <div class="empty">Нет мест по выбранному фильтру</div>
        <% } else if (view === 'map') { %>
      <% floorKeys.forEach(function(fl) { %>
        <div class="zone-block">
          <div class="zone-title">Этаж <%= fl %></div>
          <% Object.keys(floorsMap[fl]).sort().forEach(function(zone) { %>
            <div style="margin: 12px 0 8px; color:#b0bec5; font-size:0.95rem;">
              Зона <%= zone %>
            </div>
            <div class="seats-row">
              <% floorsMap[fl][zone].forEach(function(s) {
                var isFree = s.occupiedByUserId == null;
                var isMine = currentUser && s.occupiedByUserId === currentUser.id;
                var canClick = currentUser && (isFree || isMine || currentUser.role === 'admin');
                var cls = 'seat';
                if (!isFree && isMine) cls += ' mine';
                else if (!isFree) cls += ' busy';
              %>
                <% if (canClick) { %>
                  <form action="/spaces/<%= s.id %>/toggle" method="POST" class="seatform">
                    <input type="hidden" name="view" value="map">
                    <input type="hidden" name="filter" value="<%= filter %>">
                    <input type="hidden" name="sort" value="<%= sort %>">
                    <input type="hidden" name="group" value="<%= groupBy %>">
                    <button type="submit" class="<%= cls %>" title="<%= s.number %> · этаж <%= s.floor %>">
                      <%= s.number %>
                    </button>
                  </form>
                <% } else { %>
                  <div class="<%= cls %>" title="Занято"><%= s.number %></div>
                <% } %>
              <% }) %>
            </div>
          <% }) %>
        </div>
      <% }) %>
      <p class="legend">
        Зелёный — свободно · Синий — ваше · Красный — занято
      </p>
    <% } else { %>
      <div class="grid">
        <% spaces.forEach(function(s) {
          var isFree = s.occupiedByUserId == null;
          var isMine = currentUser && s.occupiedByUserId === currentUser.id;
          var canToggle = currentUser && (isFree || isMine || currentUser.role === 'admin');
        %>
          <div class="card">
            <div class="card-number"><%= s.number %></div>
            <div class="card-meta">🏢 Этаж <%= s.floor %></div>
            <div class="card-meta">💰 <%= s.pricePerHour %> BYN/час</div>

            <% if (isFree) { %>
              <span class="badge badge-free">Свободно</span>
            <% } else if (currentUser && currentUser.role === 'admin' && s.occupant) { %>
              <span class="badge badge-busy">Занято: <%= s.occupant.name ? s.occupant.name + ' (' + s.occupant.email + ')' : s.occupant.email %></span>
            <% } else if (isMine) { %>
              <span class="badge badge-mine">Ваше</span>
            <% } else { %>
              <span class="badge badge-busy">Занято</span>
            <% } %>

            <div class="card-meta" style="font-size:0.8rem; opacity:0.7;">
              Создано: <%= new Date(s.createdAt).toLocaleString('ru-RU') %>
            </div>

            <div class="card-actions">
              <a href="/item/<%= s.id %>" class="btn btn-outline btn-sm">Подробнее</a>
              <% if (canToggle) { %>
                <form action="/spaces/<%= s.id %>/toggle" method="POST">
                  <input type="hidden" name="view" value="list">
                  <input type="hidden" name="filter" value="<%= filter %>">
                  <input type="hidden" name="sort" value="<%= sort %>">
                  <input type="hidden" name="group" value="<%= groupBy %>">
                  <button type="submit" class="btn btn-sm">
                    <%= isFree ? 'Занять' : 'Освободить' %>
                  </button>
                </form>
              <% } %>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <form action="/spaces/<%= s.id %>/delete" method="POST"
                      onsubmit="return confirm('Удалить место <%= s.number %>?');">
                  <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>