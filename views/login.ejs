<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      min-height: 100vh; color: #e8eef2;
      display: flex; justify-content: center; align-items: center; padding: 20px;
    }
    .card {
      background: rgba(255,255,255,0.08); backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,0.14); border-radius: 20px;
      padding: 36px; max-width: 400px; width: 100%;
    }
    h1 { color: #4fc3f7; margin-bottom: 20px; font-size: 1.5rem; text-align: center; }
    label { display: block; font-size: 0.9rem; color: #b0bec5; margin: 14px 0 6px; }
    input {
      width: 100%; padding: 12px 14px; border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.18); background: rgba(0,0,0,0.25);
      color: #fff; font-size: 1rem; outline: none;
    }
    input:focus { border-color: #4fc3f7; }
    .btn {
      width: 100%; margin-top: 22px; padding: 14px; background: #4fc3f7;
      color: #0f2027; border: none; border-radius: 10px; font-weight: 700; cursor: pointer;
    }
    .error {
      background: rgba(244,67,54,0.2); border: 1px solid rgba(244,67,54,0.4);
      color: #ef9a9a; padding: 12px; border-radius: 10px; margin-bottom: 8px; font-size: 0.95rem;
    }
    .links { text-align: center; margin-top: 16px; font-size: 0.9rem; }
    .links a { color: #4fc3f7; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🔐 Вход</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form action="/login" method="POST">
      <label>Email</label>
      <input type="email" name="email" required maxlength="100" autocomplete="username">
      <label>Пароль</label>
      <input type="password" name="password" required minlength="6" maxlength="64"
       autocomplete="current-password">
      <button type="submit" class="btn">Войти</button>
    </form>
    <div class="links">
      <a href="/register">Регистрация</a> · <a href="/">На главную</a>
    </div>
  </div>
</body>
</html>