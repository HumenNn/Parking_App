<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Добавить место</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #1a73e8; }
    label { display: block; font-weight: bold; margin-top: 12px; }
    input { width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; }
    .btn { margin-top: 16px; padding: 10px 20px; background: #1a73e8; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    .error { color: #dc3545; background: #f8d7da; padding: 10px; border-radius: 4px; margin-bottom: 12px; }
  </style>
</head>
<body>
  <h1>Добавить парковочное место</h1>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="error"><%= error %></div>
  <% } %>
  <form action="/add?auth=1" method="POST">
    <label>Номер места</label>
    <input type="text" name="number" required minlength="1" maxlength="20" value="<%= typeof form !== 'undefined' && form.number ? form.number : '' %>">
    <label>Цена за час (BYN)</label>
    <input type="number" name="pricePerHour" required min="0" step="0.01" value="<%= typeof form !== 'undefined' && form.pricePerHour ? form.pricePerHour : '' %>">
    <label>Расположение</label>
    <input type="text" name="location" maxlength="100" value="<%= typeof form !== 'undefined' && form.location ? form.location : '' %>">
    <button type="submit" class="btn">Добавить</button>
  </form>
  <br>
  <a href="/">Назад</a>
</body>
</html>